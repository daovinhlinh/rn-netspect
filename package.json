{
  "name": "rn-netspect",
  "version": "0.1.0",
  "description": "In-app network inspector for React Native that works in release builds. Zero runtime dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daovinhlinh/rn-netspect.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "keywords": [
    "react-native",
    "network",
    "inspector",
    "devtools",
    "debugging",
    "xhr"
  ],
  "scripts": {
    "test": "esbuild test/core.test.ts --bundle --platform=node --format=cjs --alias:react-native=./test/react-native-stub.ts --outfile=test/.build/core.test.cjs --log-level=error && node test/.build/core.test.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "preversion": "yarn test && yarn typecheck",
    "version": "yarn build && git add -A dist",
    "postversion": "git push --follow-tags"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.70"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "esbuild": "^0.25.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "typescript": "^5.6.0"
  },
  "sideEffects": false
}
